# VOICEVOX
# ローカル: VOICEVOX_API_KEY を空にする
#   VOICEVOX_URL=http://localhost:50021
#
# Web高速版 (api.tts.quest): VOICEVOX_API_KEY を設定する
#   VOICEVOX_URL=https://api.tts.quest/v3/voicevox
#   VOICEVOX_API_KEY=your-api-key   # https://voicevox.su-shiki.com/su-shikiapis/ で取得
VOICEVOX_URL=http://localhost:50021
VOICEVOX_SPEAKER=1
VOICEVOX_API_KEY=

# MQTT (HiveMQ Cloud の場合)
# Broker: xxx.s1.eu.hivemq.cloud など
# Port:   8883 (TLS)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_DEVICE_ID=default

# Audio
AUDIO_DIR=/tmp/bridge-audio
AUDIO_BASE_URL=http://<raspberry-pi-ip>:8000

# OpenAI (Whisper STT + OpenClaw)
OPENAI_API_KEY=sk-...
# OpenClawがOpenAI互換エンドポイントの場合はURLを変更する
OPENCLAW_BASE_URL=https://api.openai.com/v1
OPENCLAW_MODEL=gpt-4o
# ベースシステムプロンプト（省略時はデフォルトのスタックちゃん人格が使われる）
# OPENCLAW_SYSTEM_PROMPT=あなたはスタックちゃんというかわいいアシスタントロボットです。...
