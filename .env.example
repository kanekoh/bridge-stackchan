# VOICEVOX
# ローカル: VOICEVOX_API_KEY を空にする
#   VOICEVOX_URL=http://localhost:50021
#
# Web高速版 (api.tts.quest): VOICEVOX_API_KEY を設定する
#   VOICEVOX_URL=https://api.tts.quest/v3/voicevox
#   VOICEVOX_API_KEY=your-api-key   # https://voicevox.su-shiki.com/su-shikiapis/ で取得
VOICEVOX_URL=http://localhost:50021
VOICEVOX_SPEAKER=1
VOICEVOX_API_KEY=

# MQTT (HiveMQ Cloud の場合)
# Broker: xxx.s1.eu.hivemq.cloud など
# Port:   8883 (TLS)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_DEVICE_ID=default

# OpenAI (Whisper STT)
OPENAI_API_KEY=sk-...

# OpenClaw (OpenResponses API を使用)
# Gateway URL: /v1 まで含めて設定する
# コンテナから到達する場合は host.containers.internal を使う
# 例: http://host.containers.internal:18789/v1
OPENCLAW_BASE_URL=http://localhost:18789/v1
# エージェントID (openclaw または openclaw/<agentId>)
OPENCLAW_MODEL=openclaw
# Gateway の Bearer トークン
OPENCLAW_GATEWAY_TOKEN=
# Slack チャンネルと会話履歴を共有する場合に設定する
# 形式: agent:<agentId>:slack:channel:<SlackチャンネルID>
# 例:   agent:stackchan:slack:channel:C0123456789
# 未設定の場合はセッションを共有せずスタンドアロンで動作する
OPENCLAW_SESSION_KEY=
# 応答の最大出力トークン数（未設定の場合は OpenClaw のデフォルト値を使用）
OPENCLAW_MAX_OUTPUT_TOKENS=

# Speaker ID (https://github.com/kanekoh/speaker-id)
# 未設定の場合は話者識別をスキップしてそのまま処理を続ける
# start.sh は --network host で起動するため localhost で到達できる
SPEAKER_ID_URL=http://localhost:8082
SPEAKER_ID_API_KEY=
# 識別スコアがこの値未満の場合は「不明」として扱う（0.0〜1.0）
SPEAKER_ID_THRESHOLD=0.75

# LLM バックエンド切り替え
# openclaw: OpenClaw (OpenResponses API) を使用（デフォルト）
# openai:   OpenAI Responses API を直接使用（OpenClaw が不安定な場合の代替）
LLM_BACKEND=openclaw

# OpenAI Responses API (LLM_BACKEND=openai の場合に使用)
# OPENAI_API_KEY は上記 Whisper STT と共用
# モデル例: gpt-4o-mini（軽量・高速）, gpt-4o（高精度）
OPENAI_RESPONSES_MODEL=gpt-4o-mini
# OpenAI 以外の OpenAI 互換 API を使う場合のベース URL（通常は変更不要）
OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1
# 応答の最大出力トークン数（未設定の場合は API デフォルト値を使用）
OPENAI_RESPONSES_MAX_OUTPUT_TOKENS=

# DB (会話セッション管理)
# llm_sessions テーブルに session_key ごとの previous_response_id を保存する
# LLM_BACKEND=openai の場合、再起動をまたいで会話の連続性を維持するために使用する
# デフォルトは data/bridge.db（コンテナ内のパス）
DB_PATH=data/bridge.db
