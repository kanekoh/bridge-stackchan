# =============================================================================
# bridge-stackchan 設定サンプル
# このファイルを .env にコピーして各値を設定してください。
#   cp .env.sample .env
# =============================================================================

# -----------------------------------------------------------------------------
# VOICEVOX (音声合成)
# -----------------------------------------------------------------------------
# ローカル VOICEVOX Engine を使う場合:
#   VOICEVOX_URL=http://localhost:50021
#   VOICEVOX_API_KEY=   # 空のまま
#
# Web高速版 (api.tts.quest) を使う場合:
#   API キーは https://voicevox.su-shiki.com/su-shikiapis/ で取得
VOICEVOX_URL=https://api.tts.quest/v3/voicevox
VOICEVOX_SPEAKER=3
VOICEVOX_API_KEY=your-tts-quest-api-key

# -----------------------------------------------------------------------------
# MQTT
# -----------------------------------------------------------------------------
# HiveMQ Cloud の場合: Broker は xxx.s1.eu.hivemq.cloud、Port は 8883 (TLS)
MQTT_BROKER=your-broker.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_TLS=true
MQTT_DEVICE_ID=default
MQTT_QOS=1

# -----------------------------------------------------------------------------
# Audio (音声ファイルの保存・配信)
# -----------------------------------------------------------------------------
AUDIO_DIR=/tmp/bridge-audio
AUDIO_BASE_URL=http://<raspberry-pi-ip>:8000

# -----------------------------------------------------------------------------
# OpenClaw (LLM バックエンド)
# -----------------------------------------------------------------------------
OPENCLAW_BASE_URL=http://192.168.x.x:18789/v1
OPENCLAW_MODEL=openclaw
OPENCLAW_SESSION_KEY=agent:main:slack:channel:xxxxxxxxx
OPENCLAW_GATEWAY_TOKEN=your-gateway-token
# OPENCLAW_MAX_OUTPUT_TOKENS=  # 省略時は制限なし

# LLM バックエンド切り替え: "openclaw" または "openai"
LLM_BACKEND=openai

# -----------------------------------------------------------------------------
# OpenAI (STT・LLM バックエンド)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...

# STT モデル (音声認識)
# benchmark_stt.py で計測した結果:
#   whisper-1              : 約 1,600ms  - 旧来モデル、安定
#   gpt-4o-transcribe      : 約 1,500ms  - 高精度
#   gpt-4o-mini-transcribe : 約  800ms   - 高速・低コスト (推奨)
STT_MODEL=gpt-4o-mini-transcribe

# OpenAI Responses API (LLM_BACKEND=openai のときに使用)
OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1
OPENAI_RESPONSES_MODEL=gpt-4o-mini
# OPENAI_RESPONSES_MAX_OUTPUT_TOKENS=  # 省略時は制限なし
# gpt-5.x 系（推論モデル）向け。none/low/medium/high/xhigh/max。
# 未設定時のAPIデフォルトは medium。会話用途では none で十分なことが多い。
OPENAI_RESPONSES_REASONING_EFFORT=none

# Web 検索ツール
OPENAI_RESPONSES_WEB_SEARCH=false
# OPENAI_RESPONSES_WEB_SEARCH_TOOL=web_search_preview
# OPENAI_RESPONSES_WEB_SEARCH_ON_DEMAND=false

# -----------------------------------------------------------------------------
# Speaker ID (話者識別)
# https://github.com/kanekoh/speaker-id
# 未設定の場合は話者識別をスキップしてそのまま処理を続ける
# -----------------------------------------------------------------------------
# SPEAKER_ID_URL=http://host.containers.internal:8082
# SPEAKER_ID_API_KEY=your-speaker-id-api-key
# SPEAKER_ID_THRESHOLD=0.75  # 識別スコアがこの値未満は「不明」として扱う (0.0〜1.0)

# -----------------------------------------------------------------------------
# 会話サマリ (Responses API バックエンド使用時)
# IN+OUT の合計文字数が閾値を超えたら会話を要約してセッションをリセットする。
# 要約文字数もカウンタに含まれるため、閾値 > 要約の想定文字数を推奨。
# -----------------------------------------------------------------------------
SESSION_SUMMARY_THRESHOLD=3000
SESSION_SUMMARY_MAX_TOKENS=500

# -----------------------------------------------------------------------------
# Google Calendar / Tasks (カレンダー同期・通知)
# -----------------------------------------------------------------------------
# true にすると同期・通知が有効になる
#CALENDAR_ENABLED=false
# Google Cloud Console からダウンロードした credentials.json のパス
#GOOGLE_CREDENTIALS_FILE=/app/secrets/credentials.json
# token_{key}.json を置くディレクトリ
#GOOGLE_TOKEN_DIR=/app/secrets
# Google API の同期間隔（分）
#CALENDAR_SYNC_INTERVAL_MINUTES=30
# リマインダー未設定時の通知タイミング（分前）
#CALENDAR_DEFAULT_NOTIFY_MINUTES=15
# 何日先まで同期するか
#CALENDAR_SYNC_DAYS_AHEAD=7
# 通知チェックの間隔（秒）
#CALENDAR_NOTIFY_CHECK_INTERVAL=60
# 起動遅延時の通知猶予（この分以内のもののみ送信）
#CALENDAR_NOTIFY_GRACE_MINUTES=60

# -----------------------------------------------------------------------------
# Google Geolocation API（Stack-chan からの位置情報更新）
# Google Cloud Console → APIs & Services で "Geolocation API" を有効化
# https://console.cloud.google.com/apis/library/geolocation.googleapis.com
# -----------------------------------------------------------------------------
#GOOGLE_GEOLOCATION_API_KEY=AIza...

# -----------------------------------------------------------------------------
# 天気通知（雨降り始め）
# -----------------------------------------------------------------------------
# true にすると雨降り始め通知が有効
#WEATHER_NOTIFY_RAIN=false
# チェック間隔（秒、デフォルト 15 分）
#WEATHER_CHECK_INTERVAL=900
# mm/15min 以上で「雨」とみなす
#WEATHER_RAIN_THRESHOLD=0.3

# -----------------------------------------------------------------------------
# P2P地震情報 WebSocket（防災通知）
# -----------------------------------------------------------------------------
# true にすると地震・津波通知が有効になる
#P2PQUAKE_ENABLED=false
#P2PQUAKE_WS_URL=wss://api.p2pquake.net/v2/ws
# 通知する最小震度コード（0=すべて, 10=震度1, 20=震度2, 30=震度3, 40=震度4）
#P2PQUAKE_MIN_SCALE=30
# 津波予報区（カンマ区切り）
#P2PQUAKE_TSUNAMI_TARGET_AREAS=相模湾・三浦半島,神奈川県,伊豆諸島

# -----------------------------------------------------------------------------
# ISS 通過通知
# -----------------------------------------------------------------------------
# true にすると ISS 通過通知が有効（朝の予告 + 直前通知）
#ISS_NOTIFY_ENABLED=false
# 最大仰角がこの値以上のパスのみ通知（度）。30以上推奨
#ISS_MIN_ELEVATION=30
# 何分前に直前通知するか
#ISS_NOTIFY_AHEAD=5

# -----------------------------------------------------------------------------
# 切り分け用フラグ (性能調査・デバッグ用。通常は false のまま)
# DISABLE_SESSION_HISTORY : true にすると previous_response_id を渡さず毎回新規会話
# DISABLE_TOOLS           : true にすると Function Calling・Web 検索ツールを渡さない
# 組み合わせで「Responses API 素の性能」「tools の影響」「履歴の影響」を切り分けられる
# -----------------------------------------------------------------------------
DISABLE_SESSION_HISTORY=false
DISABLE_TOOLS=false
